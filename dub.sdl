name "peque"
subPackage "subPackages/vibe"
subPackage "subPackages/orm"
subPackage "subPackages/migrate"
description "PostgreSQL client for D: a lightweight libpq binding, with an optional compile-time ORM, migration runner and vibe.d integration"
homepage "https://github.com/katyukha/peque"
authors "Dmytro Katyukha"
copyright "Copyright © 2023, Dmytro Katyukha"
license "MPL-2"
target "library"

// DMD before 2.113 miscompiles a function that returns a struct through the
// hidden return slot when its return expression leaves a temporary with a
// destructor: the caller's slot is filled, but the pointer handed back
// addresses a dead local. `repo.insert(r).id`, or passing a returned `Result`
// straight to a function, then reads a freed stack frame. peque returns such
// structs throughout. LDC is not affected.
toolchainRequirements dmd=">=2.113.0"

/* dflags "-preview=dip1000" */

dependency "versioned" version=">=0.1.1"
dependency "bindbc-common" version=">=1.0.5"


configuration "libraryStatic" {
    libs "pq"
    versions "PequeStatic"
}

configuration "libraryDynamic" {
    dependency "bindbc-loader" version=">=1.1.5"
    versions "PequeDynamic"
}

configuration "sourceLibraryStatic" {
    targetType "sourceLibrary"
    libs "pq"
    versions "PequeStatic"
}

configuration "sourceLibraryDynamic" {
    targetType "sourceLibrary"
    dependency "bindbc-loader" version=">=1.1.5"
    versions "PequeDynamic"
}

configuration "unittestStatic" {
    dflags "-checkaction=context" "-allinst"
    sourcePaths "tests"
    libs "pq"
    versions "PequeStatic"
}

configuration "unittestDynamic" {
    dependency "bindbc-loader" version=">=1.1.5"
    dflags "-checkaction=context" "-allinst"
    sourcePaths "tests"
    versions "PequeDynamic"
}
